// VETO OS v1.2 — Полный взрослый синтаксис: struct в функциях, символы 'a', циклы for
use "drivers.vt";

struct KernelState {
    row: i32<5..23>,
    cmd_len: i32<0..32>,
    ram_ok: u8<0..1>,
}

fn draw_prompt(st: KernelState) -> i32<0..0> {
    vga_print(st.row, 2, "veto@ring0:~$ ", COLOR_PROMPT);
    vga_set_cursor(st.row, 16);
    return 0;
}

fn main() -> i32<0..0> {
    idt_init();
    drv_draw_hud();

    let mut keymap: [u8<0..127>; 64] = [0; 64];
    keymap[2] = '1';
    keymap[3] = '2';
    keymap[4] = '3';
    keymap[5] = '4';
    keymap[6] = '5';
    keymap[7] = '6';
    keymap[8] = '7';
    keymap[9] = '8';
    keymap[10] = '9';
    keymap[11] = '0';
    keymap[16] = 'q';
    keymap[17] = 'w';
    keymap[18] = 'e';
    keymap[19] = 'r';
    keymap[20] = 't';
    keymap[21] = 'y';
    keymap[22] = 'u';
    keymap[23] = 'i';
    keymap[24] = 'o';
    keymap[25] = 'p';
    keymap[30] = 'a';
    keymap[31] = 's';
    keymap[32] = 'd';
    keymap[33] = 'f';
    keymap[34] = 'g';
    keymap[35] = 'h';
    keymap[36] = 'j';
    keymap[37] = 'k';
    keymap[38] = 'l';
    keymap[44] = 'z';
    keymap[45] = 'x';
    keymap[46] = 'c';
    keymap[47] = 'v';
    keymap[48] = 'b';
    keymap[49] = 'n';
    keymap[50] = 'm';
    keymap[57] = ' ';

    let mut cmd: [u8<0..127>; 32] = [0; 32];
    let mut state: KernelState = KernelState {
        row: 5,
        cmd_len: 0,
        ram_ok: 0,
    };

    draw_prompt(state);

    loop {
        let ticks: i32<0..2147483647> = irq_ticks();
        let secs: i32<-9999..9999> = (ticks / 100) % 10000;
        if secs >= 0 {
            drv_print_num4(0, 64, secs, 0x1E);
        }

        let sc: u8<0..255> = irq_pop_key();
        if sc == 0 || sc >= 64 {
            cpu_halt();
            continue;
        }

        // Backspace (14)
        if sc == 14 {
            if state.cmd_len > 0 {
                state.cmd_len -= 1;
                cmd[state.cmd_len] = 0;
                let erase_idx: i32<400..1999> = state.row * 80 + 16 + state.cmd_len;
                vga_poke(erase_idx, ' ', 0x0F);
                vga_set_cursor(state.row, 16 + state.cmd_len);
            }
            continue;
        }

        // Enter (28)
        if sc == 28 {
            let mut out_row: i32<5..24> = state.row + 1;
            if out_row > 22 {
                drv_draw_hud();
                out_row = 5;
            }

            if state.cmd_len == 5 && cmd[0] == 'c' && cmd[1] == 'l' {
                drv_draw_hud();
                out_row = 5;
            }

            if state.cmd_len == 4 && cmd[0] == 'h' && cmd[1] == 'e' {
                vga_print(out_row, 4, "VETO OS v1.2 (for-loops + char + struct fn) | Try: mem, beep, ticks, clear, reboot", 0x0A);
                out_row += 1;
            }

            if state.cmd_len == 3 && cmd[0] == 'm' && cmd[1] == 'e' {
                mem_write32(RAM_TEST_ADDR, 0x1337BEEF);
                let val: i32<-2147483648..2147483647> = mem_read32(RAM_TEST_ADDR);
                if val == 0x1337BEEF {
                    state.ram_ok = 1;
                    vga_print(out_row, 4, "[OK] Physical RAM 0x200000 verified (state.ram_ok = 1)", 0x0B);
                } else {
                    vga_print(out_row, 4, "[FAIL] RAM verification error!", 0x0C);
                }
                out_row += 1;
            }

            if state.cmd_len == 4 && cmd[0] == 'b' && cmd[1] == 'e' {
                vga_print(out_row, 4, "[PIT] Beeping PC Speaker via port 0x61...", 0x0E);
                drv_speaker_beep();
                out_row += 1;
            }

            if state.cmd_len == 5 && cmd[0] == 't' && cmd[1] == 'i' {
                let cur_t: i32<0..2147483647> = irq_ticks();
                let mod_t: i32<-9999..9999> = cur_t % 10000;
                vga_print(out_row, 4, "PIT IRQ0 Ticks (mod 10000): ", 0x0B);
                if mod_t >= 0 {
                    drv_print_num4(out_row, 32, mod_t, 0x0F);
                }
                out_row += 1;
            }

            if state.cmd_len == 6 && cmd[0] == 'r' && cmd[1] == 'e' {
                vga_print(out_row, 4, "Rebooting CPU via 8042 controller (0x64)...", 0x0C);
                cpu_reboot();
            }

            for zi in 0..32 {
                cmd[zi] = 0;
            }
            state.cmd_len = 0;

            if out_row > 21 {
                drv_draw_hud();
                state.row = 5;
            } else {
                state.row = out_row;
            }
            draw_prompt(state);
            continue;
        }

        if sc < 64 {
            let ascii: u8<0..127> = keymap[sc];
            if ascii > 0 && state.cmd_len < 31 {
                cmd[state.cmd_len] = ascii;
                let draw_idx: i32<400..1999> = state.row * 80 + 16 + state.cmd_len;
                vga_poke(draw_idx, ascii, 0x0F);
                state.cmd_len += 1;
                vga_set_cursor(state.row, 16 + state.cmd_len);
            }
        }
    }

    return 0;
}
