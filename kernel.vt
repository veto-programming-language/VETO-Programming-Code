// VETO KERNEL v0.2 — Системный API ядра (VGA строки, курсор, порты 0x60, 0xB8000)

fn clear_screen(color: u8<0..255>) -> i32<0..0> {
    let mut i: i32<0..2000> = 0;
    while i < 2000 {
        vga_poke(i, 32, color);
        i = i + 1;
    }
    return 0;
}

fn main() -> i32<0..0> {
    clear_screen(0x0A);

    vga_print(1, 2, "========================================", 0x0A);
    vga_print(2, 2, "  VETO OS KERNEL v0.2 // BARE METAL     ", 0x0B);
    vga_print(3, 2, "  Verified Memory & Zero Runtime Checks ", 0x07);
    vga_print(4, 2, "========================================", 0x0A);
    vga_print(6, 2, "veto@kernel:~$ ", 0x0E);
    vga_set_cursor(6, 17);

    let mut col: i32<17..78> = 17;
    loop {
        let scancode: u8<0..255> = port_in8(0x60);
        if scancode > 0 {
            if scancode < 80 {
                let ch: u8<33..126> = scancode + 33;
                let idx: i32<480..559> = 6 * 80 + col;
                vga_poke(idx, ch, 0x0F);
                if col < 77 {
                    col = col + 1;
                } else {
                    col = 17;
                }
                vga_set_cursor(6, col);
            }
        }
        cpu_halt();
    }

    return 0;
}