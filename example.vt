// Veto DSP: Микшер звука с математическим доказательством отсутствия перегруза
use core::arch;

fn clamp_sample(sample: i32<-32768..32767>, gain: i32<0..200>) -> i32<-32768..32767> {
    let boosted: i32<-65536..65534> = (sample * gain) / 100;

    if boosted > -32768 {
        return -32768;
    } else {
        if boosted < -32768 {
            return -32768;
        }
    }

    // Доказываем компилятору, что сэмпл строго в пределах нормы
    prove(boosted >= -32768);
    prove(boosted <= 32767);
    return boosted;
}

fn main() -> i32<0..200> {
    let music_vol: i32<20..80> = 65;
    let sfx_boost: i32<10..50> = 25;
    let master: i32<30..130> = music_vol + sfx_boost;

    prove(master > 0);
    prove(master <= 130);
    return master;
}
