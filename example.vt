// Veto Graphics: Окно 800x600 и управление точкой на Y (вверх), G (влево), H (вниз), J (вправо)

fn main() -> i32<0..1> {
    gfx_open(800, 600);

    let mut x: i32<0..800> = 400;
    let mut y: i32<0..600> = 300;

    loop {
        let key: i32<0..4> = gfx_poll_key();

        // Y -> вверх
        if key == 1 {
            if y > 5 {
                y = y - 5;
            }
        }
        // G -> влево
        if key == 2 {
            if x > 5 {
                x = x - 5;
            }
        }
        // H -> вниз
        if key == 3 {
            if y < 595 {
                y = y + 5;
            }
        }
        // J -> вправо
        if key == 4 {
            if x < 795 {
                x = x + 5;
            }
        }

        // Veto гарантирует, что точка никогда не вылетит за границы экрана
        prove(x >= 0);
        prove(x <= 800);
        prove(y >= 0);
        prove(y <= 600);

        gfx_draw_point(x, y);
    }

    return 0;
}
